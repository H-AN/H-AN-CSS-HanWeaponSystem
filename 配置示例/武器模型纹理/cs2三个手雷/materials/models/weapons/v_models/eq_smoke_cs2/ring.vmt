"VertexLitGeneric"
{
    "$basetexture" "models\weapons\v_models\eq_smoke_cs2\weapon_smokegrenade"
    "$bumpmap" "models\weapons\v_models\eq_smoke_cs2\weapon_smokegrenade_n"
    "$phongexponenttexture" "models\weapons\v_models\eq_smoke_cs2\weapon_smokegrenade_e"

    "$color2" "[0 0 0]"
    "$blendtintbybasealpha" "1"

    "$phong" "1"
    "$phongboost" "1"
    "$phongfresnelranges" "[1 0.5 0]"
